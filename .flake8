[flake8]
# Match Black rather than fighting it.
max-line-length = 88
# E203 and W503 disagree with Black by design; both are on Black's own list of
# checks to disable.
extend-ignore = E203, W503
# The vendored library stays as upstream wrote it; see pyproject.toml.
exclude = .git,__pycache__,.venv*,custom_components/tryfi/pytryfi
